# Token di @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Chat id dove mandare gli avvisi.
# DM "dal bot": metti il TUO user id. Il bot puo' scriverti solo se gli hai
# scritto almeno una volta (aprilo e premi Start).
# Gruppo/canale: id negativo, e il bot deve essere membro (admin nel canale).
# Per scoprire l'id giusto: python bot.py --chat-id
TELEGRAM_CHAT_ID=123456789

# Profili da controllare: separati da virgola oppure una per riga.
# In alternativa lascia vuoto e usa urls.txt
INSTAGRAM_URLS=https://www.instagram.com/instagram/,https://www.instagram.com/nasa/

# Secondi tra un controllo e l'altro (minimo 60)
POLL_INTERVAL=900

# File di stato con i post gia' visti
STATE_FILE=state.json

# true = al primo avvio notifica l'ultimo post esistente (default: false)
FIRST_RUN_NOTIFY=false

# Instagram serve i dati dei profili solo a sessioni loggate (anonimo = 401/429).
# Incolla qui l'header "Cookie" del browser, loggato con un account (meglio
# secondario): DevTools -> Network -> una richiesta su instagram.com ->
# Request Headers -> Cookie. Deve contenere almeno sessionid, csrftoken, ds_user_id.
INSTAGRAM_COOKIES=

# Alternativa minimale al cookie header completo
INSTAGRAM_SESSIONID=

# Log verboso
DEBUG=false
